# Copy to .env and replace both secrets with fresh, private values.
MATHMASTER_DATABASE_URL=postgresql+psycopg://mathmaster:change-me@localhost:5432/mathmaster
POSTGRES_PASSWORD=replace-with-a-different-strong-database-password
MATHMASTER_SECRET_KEY=replace-with-at-least-32-random-bytes
MATHMASTER_RESULT_SIGNING_PRIVATE_KEY=base64-encoded-32-byte-ed25519-seed
MATHMASTER_ACCESS_TOKEN_MINUTES=20160
MATHMASTER_CORS_ORIGINS=
MATHMASTER_REGISTRATION_ENABLED=true
MATHMASTER_RATE_LIMIT_WINDOW_SECONDS=60
MATHMASTER_AUTH_RATE_LIMIT=10
MATHMASTER_WEBSOCKET_RATE_LIMIT=30
MATHMASTER_BATTLE_QUESTION_TIMEOUT_SECONDS=20
MATHMASTER_RECONNECT_GRACE_SECONDS=60
